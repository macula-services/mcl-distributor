%% test.sys.config — the test environment: the crypto profile every key
%% generation and wire signature reads. Services set the same in their
%% own releases.
%%
%% ⚠ NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one constant
%% for the fleet, and REFUSES a `{macula, puzzle_difficulty, _}' setting
%% at application start whatever the value.
[
    {macula, [
        %% THE TEST'S OWN IDENTITY, NOT THE OPERATOR'S. Unset, macula stores a
        %% node identity in the account's per-user directory.
        {identity_dir, "_build/test/identity"},
        {crypto_profile, pq_hybrid}
    ]}
].
