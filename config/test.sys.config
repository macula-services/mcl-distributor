%% test.sys.config — the test environment: the crypto profile every key
%% generation and wire signature reads, the identity path (so tests never
%% touch the operator's own key), and THIS service's own posture. Services
%% set the same in their releases.
%%
%% ⚠ NO `puzzle_difficulty' HERE. macula 12 (D30) makes it one constant for
%% the fleet, and REFUSES a `{macula, puzzle_difficulty, _}' setting at
%% application start whatever the value.
[
    {macula, [
        {identity_dir, "_build/test/identity"},
        {crypto_profile, pq_hybrid},
        %% The one capability is `confidential => required', which mcl_om
        %% refuses to advertise while kem_advertise is off.
        {kem_advertise, enabled}
    ]},
    {mcl_om, [
        %% Test-local identity: minted under _build, never the operator's.
        {identity_key_path, "_build/test/mcl_distributor_identity.key"},
        %% /health on a Unix socket only, at a path a non-root test can
        %% create (the release uses /run/mcl/health.sock).
        {health_socket, "_build/test/mcl_health.sock"},
        {capability_topic, <<"_mesh.cap.">>}
    ]}
].
