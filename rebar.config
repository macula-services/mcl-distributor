%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_distributor.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. 0.39 serves /health on a Unix
    %% socket; floats within 1.x on released versions (dev rule). The floor is
    %% 1.5, the first release that names `handler_authorizes' in its
    %% `capability()' type and lets a service report a normal setup wait in
    %% /health: `~> 1.4' would also admit 1.4.0, whose info() has no room for
    %% `org_key_id' and which declares macula `~> 16.0' (macula-services/mcl-om#36).
    {mcl_om, "~> 1.6"},
    %% Named directly for macula_group_keys' named pool and epoch key
    %% redaction (14.10, mcl-distributor#1), which mcl_om's own floor does not
    %% guarantee. This is also the one service here that reads a realm
    %% endorsement: a key pull checks the caller's slot through
    %% macula_hyparview_endorsement:slot_endorsement/4, so 16.0's 24-hour window
    %% (macula#118) applies to it. Both live realms now issue 24-hour windows and
    %% renew hourly (macula-realm 0.8.2, EndorsementSweep), so the move is safe.
    %%
    %% 17.0.0 carries group read control (macula#129): the token check
    %% moved from the advertise gate into the distributor's own handler,
    %% so `macula_group_keys:advertise_opts/0' (auth => handler_authorizes)
    %% and `start_link/1' with `org_key_id', `realm' and `profile' are the
    %% shape this service knows.
    %%
    %% 18.0.0 is the caller rule (macula#147, mcl-om#42): a procedure that
    %% does not name who may call it is refused. This service already names
    %% its caller policy -- `handler_authorizes', so the link runs no gate and
    %% the handler decides on the call's own token (mcl_distributor_pull) --
    %% and mcl_om 1.6.0 declares `macula ~> 18.0' and refuses at register/1
    %% any capability that names a handler and no auth, so the two floors
    %% agree and this service's one capability satisfies both.
    {macula, "~> 18.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% The service module calls `macula' through mcl_om, so macula is not in the
%% PLT unless named here.
{dialyzer, [{plt_extra_apps, [macula]}]}.

{relx, [
    {release, {mcl_distributor, "0.6.0"}, [mcl_distributor, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    %% test_live/*.erl hit a real PQ-fleet station over the network, on
    %% purpose excluded from the default eunit (CI's main gate): a station
    %% blip must never block an unrelated PR. Run explicitly:
    %%   rebar3 as live_test eunit --dir test_live
    {live_test, [
        {extra_src_dirs, ["test_live"]},
        {eunit_opts, [{sys_config, "./config/test.sys.config"}]}
    ]},
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
